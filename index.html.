<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#103b50"><title>Rheuma Quest | MUST University</title><style>
:root{font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;color:#eaf7f8;background:#071f30}*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(circle at 50% 5%,#205e6d 0%,#0d3045 45%,#071f30 100%)}.shell{max-width:850px;margin:auto;padding:24px 18px 70px}header{text-align:center;margin:12px 0 26px}.eyebrow{letter-spacing:3px;color:#8bd8d3;font-size:12px;font-weight:700}h1{font-size:clamp(34px,6vw,58px);margin:8px 0 4px;letter-spacing:1px}h2{font-size:clamp(25px,4vw,36px);margin:8px 0 12px}p{color:#c6dde3;line-height:1.6}.panel{background:#10394b;border:1px solid #3b7280;border-radius:22px;padding:26px;box-shadow:0 16px 45px #0004;text-align:center}.hidden{display:none!important}.wheelbox{position:relative;width:min(76vw,410px);height:min(76vw,410px);margin:26px auto}.wheel{width:100%;height:100%;border-radius:50%;border:9px solid #c3e9e5;box-shadow:0 0 0 7px #2e7480,0 14px 36px #0008;background:conic-gradient(#168c99 0deg 72deg,#234e75 72deg 144deg,#26a69a 144deg 216deg,#5b5c9b 216deg 288deg,#bf7752 288deg 360deg);position:relative;transition:transform 5s cubic-bezier(.12,.78,.12,1)}.wheel .slice{position:absolute;left:50%;top:50%;width:39%;transform-origin:0 0;text-align:center;font-weight:800;font-size:clamp(10px,2.2vw,15px);line-height:1.25;text-shadow:0 2px 3px #0008}.pointer{position:absolute;z-index:2;top:-20px;left:calc(50% - 17px);width:0;height:0;border-left:17px solid transparent;border-right:17px solid transparent;border-top:34px solid #fff}.hub{position:absolute;top:calc(50% - 28px);left:calc(50% - 28px);height:56px;width:56px;border-radius:50%;background:#e8fcf9;border:7px solid #14556a;box-shadow:0 3px 10px #0006}.btn{border:0;border-radius:13px;padding:15px 23px;background:#54d4c7;color:#082d3d;font-weight:850;font-size:16px;cursor:pointer;min-height:50px}.btn:hover{filter:brightness(1.09)}.btn:disabled{opacity:.5;cursor:default}.btn.secondary{background:#234f64;color:#eaf7f8;border:1px solid #6aa4ac}.actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:22px}.tag{display:inline-block;background:#235a69;color:#a9efdf;border-radius:30px;padding:8px 14px;font-size:12px;font-weight:800;letter-spacing:1px}.big{font-size:68px;margin:20px 0}.question{text-align:left;margin:20px auto;max-width:610px}.option{display:block;width:100%;text-align:left;margin:10px 0;background:#194b5d;color:#fff;border:1px solid #4c8590;border-radius:12px;padding:14px 16px;cursor:pointer;font-size:16px}.option:hover{background:#246578}.option.selected{background:#267f81;border:2px solid #a0f2df}.option.correct{background:#175d4d;border-color:#6ce2a5}.option.wrong{background:#7e3f47;border-color:#ff9ca6}.stat{display:flex;justify-content:space-between;gap:10px;color:#9fd6db;font-weight:750}.meter{height:9px;border-radius:10px;background:#2c5665;overflow:hidden;margin:14px 0}.meter div{height:100%;background:#55dac4;width:100%;transition:width .2s}.qr{width:200px;max-width:100%;background:white;padding:10px;border-radius:12px;margin:16px auto}.small{font-size:13px;color:#a8c7cf}.notice{border:1px solid #729ba5;background:#16475a;border-radius:12px;padding:14px;margin:15px auto;max-width:620px}.choice{display:flex;gap:15px;justify-content:center;margin:22px 0}.choice button{min-width:130px;min-height:100px;border-radius:18px;border:3px solid #fff6;font-size:24px;font-weight:900;cursor:pointer;color:#fff}.green{background:#1b936c}.red{background:#c34f60}.fact{font-size:clamp(20px,3.5vw,29px);font-weight:750;color:#fff;margin:25px auto;max-width:600px}footer{text-align:center;margin-top:30px;color:#93b7c1;font-size:12px}a{color:#8fe9d9;overflow-wrap:anywhere}@media(max-width:500px){.panel{padding:18px}.shell{padding:18px 12px 50px}.wheelbox{width:min(85vw,350px);height:min(85vw,350px)}.wheel .slice{font-size:10px}.choice button{min-width:115px}}
</style></head><body><main class="shell"><header><div class="eyebrow">MUST UNIVERSITY · RHEUMATOLOGY AWARENESS</div><h1>RHEUMA QUEST</h1><p>Spin. Think. Discover.</p></header><section id="home" class="panel"><span class="tag">WELCOME · SPIN THE WHEEL</span><h2>Your next challenge awaits</h2><p>Spin to discover a surprise activity at our research booth.</p><div class="wheelbox"><div class="pointer"></div><div class="wheel" id="wheel"></div><div class="hub"></div></div><button class="btn" id="spinBtn">SPIN THE WHEEL ✦</button><p id="spinStatus" aria-live="polite" class="small">Five possibilities. One memorable experience.</p></section><section id="activity" class="panel hidden" aria-live="polite"></section><footer>Rheuma Quest · Educational booth experience · Not a clinical assessment</footer></main><script>
const RESEARCH_URL='https://beamish-klepon-8804ff.netlify.app'; // Replace if your research website changes.
const segments=[{name:'Pick a Fact',icon:'🫙',page:'fact'},{name:'5Q Challenge',icon:'🧠',page:'quiz'},{name:'Scan Our QR',icon:'📱',page:'qr'},{name:'Sweet Surprise',icon:'🍬',page:'sweet'},{name:'Red or Green',icon:'🟥🟩',page:'cards'}];
const facts=[['Rheumatoid arthritis can begin in young adulthood.','Age alone does not rule out inflammatory arthritis.'],['Persistent joint swelling deserves medical assessment.','Early evaluation can help prevent long-term joint damage.'],['Rheumatoid arthritis may affect organs beyond the joints.','It is a systemic inflammatory disease.'],['NSAIDs can cause gastrointestinal bleeding.','Risk increases in some patients and with certain drug combinations.'],['NSAIDs can worsen kidney function.','Extra caution is needed in chronic kidney disease and dehydration.'],['Early diagnosis and treatment can improve rheumatoid arthritis outcomes.','Timely referral is important when inflammatory arthritis is suspected.']];
const questions=[{q:'Which symptom is most suggestive of inflammatory arthritis?',a:['Morning stiffness lasting more than 60 minutes','Pain only after heavy exercise','Pain that always resolves within seconds'],c:0,e:'Prolonged morning stiffness is a classic inflammatory feature.'},{q:'Which is a recognized serious complication of NSAID use?',a:['Gastrointestinal bleeding','Increased bone density','Improved renal perfusion'],c:0,e:'NSAIDs can cause peptic ulceration and gastrointestinal bleeding.'},{q:'Which patient requires particular caution before NSAID use?',a:['A patient with chronic kidney disease','A patient with uncomplicated myopia','A patient with a healed superficial cut'],c:0,e:'NSAIDs may worsen kidney function, particularly in susceptible patients.'},{q:'Rheumatoid arthritis is best described as:',a:['A systemic autoimmune inflammatory disease','A bacterial infection of all joints','A disease affecting only older adults'],c:0,e:'Rheumatoid arthritis is a systemic autoimmune inflammatory disease.'},{q:'Which statement about early rheumatoid arthritis treatment is correct?',a:['Early assessment and disease-modifying treatment can improve outcomes','Treatment should always wait until joint deformities appear','NSAIDs alone prevent all long-term joint damage'],c:0,e:'Early disease-modifying treatment can reduce progression and improve outcomes.'}];
const myths=[{q:'Rheumatoid arthritis affects only older adults.',truth:false,why:'It can develop at many adult ages, including young adulthood.'},{q:'NSAIDs can increase the risk of gastrointestinal bleeding.',truth:true,why:'This is a recognized potentially serious adverse effect.'},{q:'All joint pain is caused by rheumatoid arthritis.',truth:false,why:'Joint pain has many inflammatory and non-inflammatory causes.'},{q:'Persistent joint swelling may warrant medical evaluation.',truth:true,why:'Persistent swelling can indicate inflammatory joint disease.'},{q:'NSAIDs may worsen kidney function in susceptible patients.',truth:true,why:'Renal adverse effects are an important safety consideration.'}];
const wheel=document.getElementById('wheel'),home=document.getElementById('home'),activity=document.getElementById('activity'),spinBtn=document.getElementById('spinBtn'),status=document.getElementById('spinStatus');
segments.forEach((s,i)=>{let e=document.createElement('div');e.className='slice';let angle=i*72+36-90;e.style.transform=`rotate(${angle}deg) translate(52px,-50%)`;e.innerHTML=`<span style="display:inline-block;transform:rotate(${-angle}deg)">${s.icon}<br>${s.name}</span>`;wheel.appendChild(e)});
let rotation=0,spinning=false,quizIndex=0,quizScore=0,quizAnswers=[],timeLeft=30,timer=null,mythIndex=0;
function clearTimer(){if(timer){clearInterval(timer);timer=null}}
function goHome(){clearTimer();activity.classList.add('hidden');home.classList.remove('hidden');spinBtn.disabled=false;spinning=false;status.textContent='Ready for another spin?';window.scrollTo({top:0,behavior:'smooth'})}
function show(html){home.classList.add('hidden');activity.classList.remove('hidden');activity.innerHTML=html+`<div class="actions"><button class="btn secondary" onclick="goHome()">← BACK TO THE WHEEL</button></div>`;window.scrollTo({top:0,behavior:'smooth'})}
spinBtn.addEventListener('click',()=>{if(spinning)return;spinning=true;spinBtn.disabled=true;status.textContent='Spinning…';const i=Math.floor(Math.random()*5);const current=((rotation%360)+360)%360;const target=(360-(i*72+36))%360;const delta=(target-current+360)%360;rotation+=360*6+delta;wheel.style.transform=`rotate(${rotation}deg)`;setTimeout(()=>{status.textContent=`You landed on ${segments[i].name}!`;setTimeout(()=>openPage(segments[i].page),650)},5100)});
function openPage(page){clearTimer();if(page==='fact')renderFact();if(page==='qr')renderQR();if(page==='sweet')show(`<span class="tag">SWEET SURPRISE</span><div class="big">🍬</div><h2>You won a sweet treat!</h2><p>Show this screen to our team to claim one wrapped sweet. Thank you for joining Rheuma Quest!</p><p class="small">Subject to availability and booth rules.</p>`);if(page==='cards')renderCards();if(page==='quiz')startQuiz()}
function renderFact(){let f=facts[Math.floor(Math.random()*facts.length)];show(`<span class="tag">PICK A RHEUMA FACT</span><div class="big">🫙</div><h2>Pick a note from our glass bowl</h2><p>Ask our team for the glass bowl and unfold one awareness note.</p><div class="notice"><strong>Today's awareness message</strong><div class="fact">${f[0]}</div><p>${f[1]}</p></div><button class="btn" onclick="renderFact()">SHOW ANOTHER FACT</button>`)}
function renderQR(){show(`<span class="tag">EXPLORE OUR RESEARCH</span><h2>Scan Our Research QR</h2><p>Discover our study, findings and research team.</p><img class="qr" alt="QR code to research website" src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${encodeURIComponent(RESEARCH_URL)}"><p><a href="${RESEARCH_URL}" target="_blank" rel="noopener">OPEN OUR RESEARCH WEBSITE ↗</a></p><p class="small">QR image requires internet access. The link works independently.</p>`)}
function renderCards(){mythIndex=Math.floor(Math.random()*myths.length);show(`<span class="tag">RED OR GREEN?</span><h2>Myth or Fact</h2><p>Read the statement and hold up a physical card: <strong>green = TRUE</strong>, <strong>red = FALSE</strong>.</p><div class="fact" id="mythText">${myths[mythIndex].q}</div><div class="choice"><button class="green" onclick="answerMyth(true)">GREEN<br><small>TRUE</small></button><button class="red" onclick="answerMyth(false)">RED<br><small>FALSE</small></button></div><div id="mythResult"></div>`)}
function answerMyth(v){let m=myths[mythIndex],ok=v===m.truth;document.getElementById('mythResult').innerHTML=`<div class="notice"><strong>${ok?'✓ Correct!':'Not quite.'}</strong><p>${m.why}</p></div><button class="btn" onclick="renderCards()">NEXT STATEMENT</button>`}
function startQuiz(){quizIndex=0;quizScore=0;quizAnswers=[];timeLeft=30;renderQuiz();timer=setInterval(()=>{timeLeft--;let t=document.getElementById('timer'),bar=document.getElementById('timebar');if(t)t.textContent=`${timeLeft}s`;if(bar)bar.style.width=(timeLeft/30*100)+'%';if(timeLeft<=0)finishQuiz()},1000)}
function renderQuiz(){if(quizIndex>=questions.length){finishQuiz();return}let q=questions[quizIndex];show(`<span class="tag">5-QUESTION CHALLENGE</span><h2>Think Fast. Answer Smart.</h2><div class="stat"><span>QUESTION ${quizIndex+1} / 5</span><span id="timer">${timeLeft}s</span></div><div class="meter"><div id="timebar" style="width:${timeLeft/30*100}%"></div></div><div class="question"><h3>${q.q}</h3>${q.a.map((a,i)=>`<button class="option" id="option${i}" onclick="chooseAnswer(${i})">${String.fromCharCode(65+i)}. ${a}</button>`).join('')}</div><div id="feedback" class="small">Select one answer to continue.</div>`)}
function chooseAnswer(i){if(quizAnswers[quizIndex]!==undefined)return;let q=questions[quizIndex];quizAnswers[quizIndex]=i;if(i===q.c)quizScore++;q.a.forEach((_,j)=>{let b=document.getElementById('option'+j);b.disabled=true;if(j===q.c)b.classList.add('correct');else if(j===i)b.classList.add('wrong')});document.getElementById('feedback').innerHTML=`<div class="notice"><strong>${i===q.c?'Correct!':'Incorrect.'}</strong><p>${q.e}</p></div><button class="btn" onclick="nextQuiz()">${quizIndex===4?'SEE MY RESULT':'NEXT QUESTION →'}</button>`}
function nextQuiz(){quizIndex++;renderQuiz()}
function finishQuiz(){clearTimer();show(`<span class="tag">CHALLENGE COMPLETE</span><div class="big">🏆</div><h2>${quizScore} / 5 Correct</h2><p>${quizScore===5?'Excellent! Perfect score.':quizScore>=3?'Well done! Keep building your knowledge.':'Every question is an opportunity to learn.'}</p><div class="notice">How much do medical students know about rheumatology and NSAID safety? Explore our study to discover the findings.</div><div class="actions"><button class="btn" onclick="startQuiz()">TRY AGAIN</button><button class="btn secondary" onclick="renderQR()">EXPLORE OUR RESEARCH</button></div>`)}
window.goHome=goHome;window.renderFact=renderFact;window.renderCards=renderCards;window.answerMyth=answerMyth;window.startQuiz=startQuiz;window.chooseAnswer=chooseAnswer;window.nextQuiz=nextQuiz;window.renderQR=renderQR;
</script></body></html>
